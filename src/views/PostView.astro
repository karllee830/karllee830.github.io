---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { localePath, useTranslations, type OutlineItem } from '../i18n/ui';
import { withBase } from '../lib/url';
import { formatDate, postHref, readingMinutes, type Post } from '../lib/posts';
import '../styles/prose.css';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, description, date, updated, lang, tags, cover, coverAlt } = post.data;
const t = useTranslations(lang);
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body);

const outline: OutlineItem[] = [
  { id: 'post-title', text: t('outline.intro'), depth: 2 },
  ...headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ id: h.slug, text: h.text, depth: h.depth })),
  ...(site.comments.enabled ? [{ id: 'comments-title', text: t('post.comments'), depth: 2 }] : []),
];

// The pager always offers two ways on: neighbours, or the index and home at the ends.
const prevLink = prev
  ? { href: postHref(prev), label: t('post.prev'), title: prev.data.title, rel: 'prev' }
  : { href: localePath(lang, '/blog/'), label: t('post.prev'), title: t('post.back'), rel: undefined };
const nextLink = next
  ? { href: postHref(next), label: t('post.next'), title: next.data.title, rel: 'next' }
  : { href: localePath(lang, '/'), label: t('post.next'), title: t('post.home'), rel: undefined };
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  section="blog"
  routes={{ [lang]: `/blog/${post.id}/` }}
  fallbackRoute="/blog/"
  type="article"
  publishedTime={date}
  outline={outline}
>
  <article class="post">
    <header class="post-header" data-page-opening>
      <a class="back pill-link cursor sq" href={localePath(lang, '/blog/')}>
        {t('post.back')}
      </a>
      <h1 id="post-title">{title}</h1>
      <p class="meta">
        <time class="mono" datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} {t('post.minutes')}</span>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t('post.updated')} <time class="mono" datetime={updated.toISOString()}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li class="mono">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <Image class="cover sq" src={cover} alt={coverAlt ?? ''} widths={[600, 1200]} sizes="(min-width: 768px) 600px, 100vw" loading="eager" />
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <div class="after">
    <aside class="end-card sq sq-line" aria-labelledby="end-title">
      <p id="end-title" class="end-title">{t('end.title')}</p>
      <p class="end-body">{t('end.body')}</p>
      <div class="end-actions">
        {
          site.comments.enabled && (
            <a class="end-action sq sq-line" href="#comments-title">
              <Icon name="message" size={18} />
              {t('end.comment')}
            </a>
          )
        }
        <a class="end-action sq sq-line" href={`https://github.com/${site.github}`} rel="me noopener">
          <Icon name="github" size={18} />
          GitHub
        </a>
        <a class="end-action sq sq-line" href={withBase('/rss.xml')}>
          <Icon name="rss" size={18} />
          {t('end.subscribe')}
        </a>
      </div>
    </aside>

    {site.comments.enabled && <Comments lang={lang} term={`blog/${post.id}`} />}

    <nav class="pager" aria-label={`${t('post.prev')} / ${t('post.next')}`}>
      <a class="pager-card sq sq-line" href={prevLink.href} rel={prevLink.rel}>
        <span class="pager-label">{prevLink.label}</span>
        <span class="pager-title"><span class="cursor">{prevLink.title}</span></span>
      </a>
      <a class="pager-card next sq sq-line" href={nextLink.href} rel={nextLink.rel}>
        <span class="pager-label">{nextLink.label}</span>
        <span class="pager-title"><span class="cursor">{nextLink.title}</span></span>
      </a>
    </nav>
  </div>
</BaseLayout>

<style>
  .post-header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .back {
    justify-self: start;
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-headline);
    line-height: var(--leading-headline);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-fg-subtle);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--color-fg-muted);
  }

  .post :global(.cover) {
    --sq-r: var(--radius-4);
    width: 100%;
    margin-bottom: var(--space-10);
    background-color: var(--color-surface-2);
  }

  .after {
    display: grid;
    gap: var(--space-12);
    margin-top: var(--space-16);
  }

  /* Looks like a prose block so it reads as part of the article. */
  .end-card {
    --sq-r: var(--radius-4);
    --sq-bg: var(--color-surface-2);
    display: grid;
    gap: var(--space-2);
    padding: var(--space-5);
  }

  .end-title {
    font-weight: var(--weight-semibold);
  }

  .end-body {
    color: var(--color-fg-muted);
  }

  .end-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  /* Radius 12 inside a 16 card (gap ≥ padding, so 12 reads as nested). */
  .end-action {
    --sq-r: var(--radius-3);
    --sq-bg: var(--color-surface);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-lg);
    padding-inline: var(--space-4);
    font-weight: var(--weight-medium);
    transition:
      --sq-bg var(--duration-fast) var(--ease-out),
      --sq-border var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .end-action:hover {
    --sq-bg: var(--color-hover);
    --sq-border: var(--color-line-strong);
  }

  .end-action:active {
    transform: scale(0.97);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .pager-card {
    --sq-r: var(--radius-4);
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
  }

  .pager-card {
    transition:
      --sq-bg var(--duration-fast) var(--ease-out),
      --sq-border var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .pager-card:hover {
    --sq-bg: var(--color-hover);
    --sq-border: var(--color-line-strong);
  }

  .pager-card:active {
    transform: scale(0.99);
  }

  .pager-card.next {
    text-align: right;
  }

  .pager-label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-fg-subtle);
  }

  .pager-card.next .pager-label {
    justify-content: flex-end;
  }

  .pager-title {
    font-weight: var(--weight-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
