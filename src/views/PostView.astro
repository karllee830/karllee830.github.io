---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Comments from '../components/Comments.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { localePath, useTranslations } from '../i18n/ui';
import { formatDate, postHref, readingMinutes, type Post } from '../lib/posts';
import '../styles/prose.css';

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, description, date, updated, lang, tags, cover, coverAlt } = post.data;
const t = useTranslations(lang);
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  section="blog"
  routes={{ [lang]: `/blog/${post.id}/` }}
  fallbackRoute="/blog/"
  type="article"
  publishedTime={date}
>
  <article class="post">
    <header class="post-header">
      <a class="back" href={localePath(lang, '/blog/')}>
        <Icon name="arrow-left" size={14} />
        {t('post.back')}
      </a>
      <h1>{title}</h1>
      <p class="meta">
        <time class="mono" datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} {t('post.minutes')}</span>
        {
          updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t('post.updated')} <time class="mono" datetime={updated.toISOString()}>{formatDate(updated)}</time>
              </span>
            </>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li class="mono">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <Image class="cover sq" src={cover} alt={coverAlt ?? ''} widths={[600, 1200]} sizes="(min-width: 768px) 600px, 100vw" loading="eager" />
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <div class="after">
  {
    (prev || next) && (
      <nav class="pager" aria-label={`${t('post.prev')} / ${t('post.next')}`}>
        {prev ? (
          <a class="pager-card sq sq-line" href={postHref(prev)} rel="prev">
            <span class="pager-label">{t('post.prev')}</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="pager-card next sq sq-line" href={postHref(next)} rel="next">
            <span class="pager-label">{t('post.next')}</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        )}
      </nav>
    )
  }

  {site.comments.enabled && <Comments lang={lang} term={`blog/${post.id}`} />}
  </div>
</BaseLayout>

<style>
  .post-header {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    justify-self: start;
    margin-bottom: var(--space-4);
    color: var(--color-fg-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .back :global(svg) {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .back:hover {
    color: var(--color-fg);
  }

  .back:hover :global(svg) {
    transform: translateX(-2px);
  }

  h1 {
    font-size: var(--text-headline);
    line-height: var(--leading-headline);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-fg-subtle);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    color: var(--color-fg-muted);
  }

  .post :global(.cover) {
    --sq-r: var(--radius-4);
    width: 100%;
    margin-bottom: var(--space-10);
    background-color: var(--color-surface-2);
  }

  .after {
    display: grid;
    gap: var(--space-12);
    margin-top: var(--space-16);
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .pager-card {
    --sq-r: var(--radius-4);
    display: grid;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
  }

  .pager-card:hover {
    --sq-bg: var(--color-hover);
    --sq-border: var(--color-line-strong);
  }

  .pager-card.next {
    text-align: right;
  }

  .pager-label {
    color: var(--color-fg-subtle);
  }

  .pager-title {
    font-weight: var(--weight-medium);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
