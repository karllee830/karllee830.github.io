---
import LangBadge from './LangBadge.astro';
import { formatDate, formatMonthDay, postHref, type PostEntry } from '../lib/posts';
import type { Lang } from '../i18n/ui';

interface Props {
  posts: PostEntry[];
  lang: Lang;
  /** Show month-day only (when the list is already grouped by year). */
  short?: boolean;
}

const { posts, lang, short = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map(({ post, langs }) => (
      <li>
        <a class="row sq" href={postHref(post, lang)} lang={post.data.lang === lang ? undefined : post.data.lang === 'zh' ? 'zh-CN' : 'en'}>
          <span class="title cursor">{post.data.title}</span>
          <span class="meta">
            {post.data.draft && <span class="draft-tag">draft</span>}
            <LangBadge langs={langs} current={post.data.lang} lang={lang} />
            <time class="mono" datetime={post.data.date.toISOString()}>
              {short ? formatMonthDay(post.data.date) : formatDate(post.data.date)}
            </time>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    /* Rows bleed into the gutter so text stays aligned with the column. */
    margin-inline: calc(-1 * var(--space-3));
  }

  .row {
    --sq-r: var(--radius-3);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .row {
    transition:
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .row:hover {
    background-color: var(--color-hover);
  }

  .row:active {
    background-color: var(--color-line);
    transform: scale(0.995);
  }

  .row:hover .meta {
    color: var(--color-fg-muted);
  }

  .title {
    min-width: 0;
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    color: var(--color-fg-subtle);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .draft-tag {
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }

  time {
    font-size: var(--text-caption);
  }
</style>
