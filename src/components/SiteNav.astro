---
import MiniAvatar from './MiniAvatar.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import LangSwitch from './LangSwitch.astro';
import { site } from '../config/site';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

export type Section = 'home' | 'blog' | 'none';

interface Props {
  lang: Lang;
  section: Section;
  langHrefs: Record<Lang, string>;
}

const { lang, section, langHrefs } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
const items = [
  { href: home, label: t('nav.home'), current: section === 'home', key: 'home' },
  { href: localePath(lang, '/blog/'), label: t('nav.blog'), current: section === 'blog', key: 'blog' },
  { href: `${home}#links`, label: t('nav.links'), current: false, key: 'links' },
];
---

<header class="site-nav">
  <a class="brand sq" href={home} aria-label={site.name}>
    <span class="brand-mark sq"><MiniAvatar size={20} /></span>
    <span class="brand-name">{site.name}</span>
  </a>

  <nav class="nav-links" aria-label={t('nav.label')}>
    <ul>
      {
        items.map((item) => (
          <li class={`nav-item nav-item--${item.key}`}>
            <a class="nav-link sq" href={item.href} aria-current={item.current ? 'page' : undefined}>
              <span>{item.label}</span>
              <span class="marker" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="nav-tools">
    <LangSwitch lang={lang} hrefs={langHrefs} />
    <ThemeSwitch lang={lang} />
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--topbar-height);
    padding-inline: var(--page-gutter);
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  /* Rows are 32px; hover pills bleed 8px so text stays on the grid. */
  .brand {
    --sq-r: var(--radius-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    height: var(--control-md);
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-1);
    margin-left: calc(-1 * var(--space-1));
    font-weight: var(--weight-semibold);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .brand:hover {
    background-color: var(--color-hover);
  }

  /* Brand mark: 24px box, radius 8 = brand radius 12 − 4px padding. */
  .brand-mark {
    --sq-r: calc(var(--radius-3) - var(--space-1));
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--control-sm);
    height: var(--control-sm);
    color: var(--color-fg);
    background-color: var(--color-surface-2);
    overflow: hidden;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .brand:hover .brand-mark {
    background-color: var(--color-surface);
  }

  .brand-mark :global(svg) {
    width: 20px;
    height: 20px;
    margin-top: 4px;
  }

  .brand:hover .brand-mark :global(svg) {
    animation: hop 420ms var(--ease-out);
  }

  @keyframes hop {
    35% {
      transform: translateY(-3px);
    }
    70% {
      transform: translateY(1px);
    }
  }

  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-links {
    margin-left: auto;
  }

  .nav-links ul {
    display: flex;
    gap: var(--space-1);
  }

  .nav-link {
    --sq-r: var(--radius-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: var(--control-md);
    padding-inline: var(--space-2);
    color: var(--color-fg-muted);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-fg);
    background-color: var(--color-hover);
  }

  .nav-link:active {
    background-color: var(--color-line);
  }

  .nav-link[aria-current] {
    color: var(--color-fg);
    font-weight: var(--weight-medium);
  }

  /* One accent pixel marks the current section. */
  .marker {
    display: none;
    width: 4px;
    height: 4px;
    background-color: var(--color-accent);
    transform: scale(0);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-link[aria-current] .marker {
    transform: scale(1);
  }

  .nav-item--home,
  .nav-item--links {
    display: none;
  }

  .nav-tools {
    display: flex;
    gap: var(--space-2);
  }

  @media (max-width: 359px) {
    .brand-name {
      display: none;
    }
  }

  /* Desktop: sticky sidebar */
  @media (min-width: 1024px) {
    .site-nav {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
      height: 100dvh;
      max-height: 100dvh;
      padding: var(--space-12) 0;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border-bottom: 0;
    }

    .brand {
      align-self: flex-start;
      margin-left: calc(-1 * var(--space-1));
    }

    .nav-links {
      margin: 0 calc(-1 * var(--space-2));
    }

    .nav-links ul {
      flex-direction: column;
      gap: 2px;
    }

    .nav-item--home,
    .nav-item--links {
      display: list-item;
    }

    .marker {
      display: block;
    }

    .nav-tools {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      margin-top: auto;
    }
  }
</style>
