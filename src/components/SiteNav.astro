---
import MiniAvatar from './MiniAvatar.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import LangSwitch from './LangSwitch.astro';
import Outline from './Outline.astro';
import Beian from './Beian.astro';
import { site } from '../config/site';
import { localePath, useTranslations, type Lang, type OutlineItem } from '../i18n/ui';

export type Section = 'home' | 'blog' | 'none';

interface Props {
  lang: Lang;
  section: Section;
  langHrefs: Record<Lang, string>;
  outline: OutlineItem[];
}

const { lang, section, langHrefs, outline } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
const items = [
  { href: home, label: t('nav.home'), current: section === 'home', key: 'home' },
  { href: localePath(lang, '/blog/'), label: t('nav.blog'), current: section === 'blog', key: 'blog' },
  { href: `${home}#links-title`, label: t('nav.links'), current: false, key: 'links' },
];
---

<!-- The slot keeps the header's space when it turns fixed on narrow screens. -->
<div class="nav-slot">
<header class="site-nav" data-site-header>
  <a class="brand sq" href={home} aria-label={site.name}>
    <span class="brand-mark sq"><MiniAvatar size={20} /></span>
    <span class="brand-name">{site.name}</span>
  </a>

  <nav class="nav-links" aria-label={t('nav.label')}>
    <ul>
      {
        items.map((item) => (
          <li class={`nav-item nav-item--${item.key}`}>
            <a class="nav-link sq" href={item.href} aria-current={item.current ? 'page' : undefined}>
              <span>{item.label}</span>
              <span class="marker" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {outline.length > 0 && <Outline lang={lang} items={outline} />}

  <div class="nav-tools is-bar">
    <LangSwitch lang={lang} hrefs={langHrefs} />
    <ThemeSwitch lang={lang} />
  </div>
</header>
<!-- Desktop copy of the tools, pinned to the bottom of the sidebar column. -->
<div class="nav-tools is-side">
  <LangSwitch lang={lang} hrefs={langHrefs} />
  <ThemeSwitch lang={lang} />
  <Beian class="side-beian" />
</div>
</div>

<style>
  /*
   * Narrow screens: the header belongs to the page and scrolls away with it,
   * then returns as a floating bar once the page opening has left the screen
   * (data-float is set by src/lib/layout-scroll.ts).
   */
  .nav-slot {
    height: var(--topbar-height);
  }

  .site-nav {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--topbar-height);
    padding-inline: var(--page-gutter);
  }

  .site-nav[data-float] {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    background-color: color-mix(in srgb, var(--color-bg) 80%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow:
      0 1px 0 var(--color-line),
      0 8px 24px -16px rgb(0 0 0 / 0.25);
  }

  .site-nav[data-float="floating"] {
    animation: header-in 320ms var(--ease-out);
  }

  .site-nav[data-float="leaving"] {
    animation: header-out 120ms var(--ease-out) forwards;
  }

  @keyframes header-in {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(-24px);
    }
  }

  @keyframes header-out {
    to {
      opacity: 0;
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav[data-float] {
      animation: none;
    }
  }

  /* Rows are 32px; hover pills bleed 8px so text stays on the grid. */
  .brand {
    --sq-r: var(--radius-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    height: var(--control-md);
    padding: var(--space-1) var(--space-2) var(--space-1) var(--space-1);
    margin-left: calc(-1 * var(--space-1));
    font-weight: var(--weight-semibold);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .brand:hover {
    background-color: var(--color-hover);
  }

  /* Brand mark: 24px box, radius 8 = brand radius 12 − 4px padding. */
  .brand-mark {
    --sq-r: calc(var(--radius-3) - var(--space-1));
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--control-sm);
    height: var(--control-sm);
    color: var(--color-fg);
    background-color: var(--color-surface-2);
    overflow: hidden;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .brand:hover .brand-mark {
    background-color: var(--color-surface);
  }

  .brand-mark :global(svg) {
    width: 20px;
    height: 20px;
    margin-top: 4px;
  }

  .brand:hover .brand-mark :global(svg) {
    animation: hop 420ms var(--ease-out);
  }

  @keyframes hop {
    35% {
      transform: translateY(-3px);
    }
    70% {
      transform: translateY(1px);
    }
  }

  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-links {
    display: none;
  }

  .nav-links ul {
    display: flex;
    gap: var(--space-1);
  }

  .nav-link {
    --sq-r: var(--radius-2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    height: var(--control-md);
    padding-inline: var(--space-2);
    color: var(--color-fg-muted);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-fg);
    background-color: var(--color-hover);
  }

  .nav-link:active {
    background-color: var(--color-line);
  }

  .nav-link[aria-current] {
    color: var(--color-fg);
    font-weight: var(--weight-medium);
  }

  /* One accent pixel marks the current section. */
  .marker {
    display: none;
    width: 4px;
    height: 4px;
    background-color: var(--color-accent);
    transform: scale(0);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .nav-link[aria-current] .marker {
    transform: scale(1);
  }

  .nav-item--home,
  .nav-item--links {
    display: none;
  }

  .nav-tools {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
  }

  .nav-tools.is-side {
    display: none;
  }

  @media (max-width: 359px) {
    .brand-name {
      display: none;
    }
  }

  /*
   * Desktop: sticky sidebar. It sticks at the place it starts, so nothing
   * jumps when scrolling begins; the end of the layout pushes it up.
   */
  /*
   * Desktop: the sidebar column runs the full page height. Inside it the
   * header sticks to the top and the tools stick to the bottom of the same
   * cell, so both stay on screen while reading.
   */
  @media (min-width: 1024px) {
    .nav-slot {
      /* Two switches plus the two filing lines below them. */
      --tools-height: calc(
        2 * var(--control-md) + var(--space-2) + var(--space-4) + 2 * var(--leading-caption) + var(--space-1)
      );
      display: grid;
      grid-template: 1fr / 1fr;
      height: auto;
      padding: 0 var(--space-6) var(--space-12) 0;
    }

    .site-nav {
      grid-area: 1 / 1;
      position: sticky;
      top: 0;
      align-self: start;
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-6);
      height: auto;
      /* Leaves room for the tools so the two never overlap. */
      max-height: calc(100dvh - var(--tools-height) - var(--space-12) - var(--space-6));
      padding: var(--space-12) 0 0;
      /* Sticky keeps the margin box in the column, so the header stops above the tools at the end. */
      margin-bottom: calc(var(--tools-height) + var(--space-6));
    }

    .site-nav[data-float] {
      position: sticky;
      background: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      box-shadow: none;
      animation: none;
    }

    .brand {
      align-self: flex-start;
      margin-left: calc(-1 * var(--space-1));
    }

    .nav-links {
      display: block;
      margin: 0 calc(-1 * var(--space-2));
    }

    .nav-links ul {
      flex-direction: column;
      gap: 2px;
    }

    .nav-item--home,
    .nav-item--links {
      display: list-item;
    }

    .marker {
      display: block;
    }

    .nav-tools.is-bar {
      display: none;
    }

    .nav-tools.is-side :global(.side-beian) {
      margin-top: var(--space-2);
      /* The filing lines may use the column's right padding. */
      margin-right: calc(-1 * var(--space-6));
    }

    .nav-tools.is-side {
      grid-area: 1 / 1;
      position: sticky;
      bottom: var(--space-12);
      align-self: end;
      justify-self: start;
      margin-left: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
