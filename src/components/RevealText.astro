---
// Splits text into characters that fade in one after another.
// Words stay unbreakable; Chinese wraps between phrases (see src/lib/phrases.mjs).
import { phrases } from '../lib/phrases.mjs';
import { autospaceBetween } from '../lib/cjk.mjs';

interface Props {
  text: string;
  /** Index of the first character, to continue a sequence. */
  start?: number;
}

const { text, start = 0 } = Astro.props;

// Each Latin word or Chinese phrase becomes one unbreakable word.
const tokens: string[] = [];
for (const part of text.split(/(\s+)/)) {
  if (!part) continue;
  if (/^\s+$/.test(part)) tokens.push(' ');
  else tokens.push(...phrases(part));
}

let index = start;
const words = tokens.map((token) => {
  if (token === ' ') return null;
  return [...token].map((ch) => ({ ch, i: index++ }));
});
---

<span class="sr-only">{text}</span><span aria-hidden="true">{
  words.map((word, w) =>
    word === null ? (
      ' '
    ) : (
      <>
        {w > 0 && words[w - 1] !== null && <wbr />}
        <span
          class:list={[
            'reveal-word',
            { 'is-spaced': autospaceBetween(words[w - 1]?.at(-1)?.ch, word[0]?.ch) },
          ]}
        >
          {word.map(({ ch, i }) => (
            <span class="reveal-char" style={`--i:${i}`}>
              {ch}
            </span>
          ))}
        </span>
      </>
    ),
  )
}</span>
