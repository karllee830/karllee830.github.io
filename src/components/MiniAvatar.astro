---
// Monochrome rendition of the pixel avatar (head and shoulders), drawn
// with currentColor so it follows the theme.
import { avatar } from '../data/avatar';
import { buildAvatarModel } from '../lib/avatar-model';

interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
const model = buildAvatarModel(avatar);

// Square crop around the head.
const { x0, x1, y0 } = model.bounds;
const span = 16;
const cx = Math.round((x0 + x1 + 1) / 2);
const left = cx - span / 2;
const top = y0 - 1;
const cells = model.cells.filter((c) => c.x >= left && c.x < left + span && c.y >= top && c.y < top + span);
---

<svg
  class:list={['mini-avatar', className]}
  viewBox={`${left} ${top} ${span} ${span}`}
  width={size}
  height={size}
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {
    cells.map((c) => (
      <rect
        x={c.x}
        y={c.y}
        width="1"
        height="1"
        fill={c.accent ? 'var(--color-accent)' : 'currentColor'}
        fill-opacity={c.accent ? c.tone.toFixed(2) : (0.12 + 0.88 * c.tone).toFixed(2)}
      />
    ))
  }
</svg>
