---
// Monochrome rendition of the pixel avatar (head and shoulders), drawn
// with currentColor so it follows the theme.
import { avatar } from '../data/avatar';
import { buildAvatarModel, headCrop, markOpacity } from '../lib/avatar-model';

interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
const { left, top, span, cells } = headCrop(buildAvatarModel(avatar));
---

<svg
  class:list={['mini-avatar', className]}
  viewBox={`${left} ${top} ${span} ${span}`}
  width={size}
  height={size}
  shape-rendering="crispEdges"
  aria-hidden="true"
>
  {
    cells.map((c) => (
      <rect
        x={c.x}
        y={c.y}
        width="1"
        height="1"
        fill={c.accent ? 'var(--color-accent)' : 'currentColor'}
        fill-opacity={markOpacity(c).toFixed(2)}
      />
    ))
  }
</svg>
