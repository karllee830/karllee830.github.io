---
import Icon from './Icon.astro';
import { site, localize } from '../config/site';
import { localePath, type Lang } from '../i18n/ui';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

/** URL as printed on the tray: no protocol, no trailing slash. */
const printable = (href: string) => {
  const absolute = href.startsWith('/') ? new URL(href, Astro.site).href : href;
  return absolute.replace(/^(https?:\/\/|mailto:)/, '').replace(/\/$/, '');
};

const links = site.links.map((link) => {
  const href = link.internal ? (link.localized ? localePath(lang, link.href) : withBase(link.href)) : link.href;
  return {
    ...link,
    label: localize(link.label, lang),
    detail: localize(link.detail, lang),
    href,
    url: printable(href),
    external: !link.internal && /^https?:/.test(link.href),
  };
});
---

<ul class="link-grid">
  {
    links.map((link) => (
      <li>
        <a class="link-item" href={link.href} rel={link.external ? 'me noopener' : undefined}>
          <span class="card sq sq-line">
            <span class="key sq">
              <Icon name={link.icon} size={16} />
            </span>
            <span class="text">
              <span class="label">{link.label}</span>
              <span class="detail">{link.detail}</span>
            </span>
          </span>
          <span class="tray sq" aria-hidden="true">
            <span class="led" />
            <span class="url mono">{link.url}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--space-2);
  }

  li {
    position: relative;
  }

  li:hover,
  li:focus-within {
    z-index: 2;
  }

  /*
   * Flat at rest; turns tactile on hover. The wrapper carries the shadow so
   * it follows the squircle clip as well.
   */
  .link-item {
    position: relative;
    display: block;
    isolation: isolate;
    text-decoration: none;
    filter: var(--shadow-rest);
    transition: filter var(--duration-base) var(--ease-out);
  }

  /* Card radius 16 with 8px padding → key radius 8. */
  .card {
    --card-radius: var(--radius-4);
    --card-padding: var(--space-2);
    --sq-r: var(--card-radius);
    --sq-bg: var(--color-bg);
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--card-padding);
    padding-right: var(--space-4);
    /* Clip the hover finish to the card's (inner) rounded shape. */
    overflow: hidden;
    transition:
      transform var(--duration-base) var(--ease-out),
      --sq-border var(--duration-fast) var(--ease-out);
  }

  /* Raised finish, faded in on hover (gradients themselves can't transition). */
  .card::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(var(--raised-top), var(--raised-bottom));
    box-shadow:
      inset 0 1px 0 var(--raised-highlight),
      inset 0 -1px 0 var(--raised-edge);
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }

  /* Keycap-style icon well. */
  .key {
    --sq-r: calc(var(--card-radius) - var(--card-padding));
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--control-lg);
    height: var(--control-lg);
    color: var(--color-fg);
    background-color: var(--color-surface-2);
    box-shadow:
      inset 0 1px 0 transparent,
      inset 0 -2px 0 transparent;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }


  .key :global(svg) {
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .text {
    display: grid;
    min-width: 0;
  }

  .label {
    font-weight: var(--weight-medium);
  }

  .detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-fg-subtle);
  }


  /*
   * Tray: hidden under the card, slides out on hover with a slight
   * overshoot and tucks back without one. The top is shaded where the card
   * overhangs it.
   */
  .tray {
    --sq-r: var(--radius-3);
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    top: calc(100% - var(--space-4));
    z-index: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: calc(var(--space-4) + 28px);
    padding: var(--space-4) var(--space-3) 0;
    background-color: var(--tray-bg);
    box-shadow:
      inset 0 10px 8px -6px rgb(0 0 0 / 0.8),
      inset 0 0 0 1px var(--tray-edge);
    /* Parked 4px higher than needed so the 2px card lift never reveals it. */
    opacity: 0;
    transform: translateY(-32px);
    transition:
      transform var(--duration-base) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .led {
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--tray-muted);
    transition:
      background-color var(--duration-base) var(--ease-out) 160ms,
      box-shadow var(--duration-base) var(--ease-out) 160ms;
  }

  /* URL types itself out once the tray is open. */
  .url {
    overflow: hidden;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    letter-spacing: 0.02em;
    color: var(--tray-fg);
    white-space: nowrap;
    text-overflow: ellipsis;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0ms;
  }

  .link-item:hover,
  .link-item:focus-visible {
    filter: var(--shadow-lift);
  }

  .link-item:hover .card,
  .link-item:focus-visible .card {
    --sq-border: var(--color-line-strong);
    transform: translateY(-2px);
  }

  .link-item:hover .card::after,
  .link-item:focus-visible .card::after {
    opacity: 1;
  }

  .link-item:hover .key,
  .link-item:focus-visible .key {
    background-color: var(--key-bottom);
    background-image: linear-gradient(var(--key-top), var(--key-bottom));
    box-shadow:
      inset 0 1px 0 var(--raised-highlight),
      inset 0 -2px 0 var(--raised-edge);
  }

  .link-item:hover .key :global(svg),
  .link-item:focus-visible .key :global(svg) {
    transform: rotate(-8deg) scale(1.08);
  }


  .link-item:hover .tray,
  .link-item:focus-visible .tray {
    opacity: 1;
    transform: translateY(0);
    transition:
      transform 420ms cubic-bezier(0.34, 1.4, 0.64, 1),
      opacity 0ms;
  }

  .link-item:hover .led,
  .link-item:focus-visible .led {
    background-color: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  .link-item:hover .url,
  .link-item:focus-visible .url {
    clip-path: inset(0 0 0 0);
    transition: clip-path 480ms steps(20, end) 140ms;
  }

  /* Pressed: card sinks back and the keycap goes down. */
  .link-item:active .card {
    transform: translateY(0);
  }

  .link-item:active .card::after {
    box-shadow:
      inset 0 2px 4px var(--raised-edge),
      inset 0 -1px 0 var(--raised-highlight);
  }

  .link-item:active .key {
    transform: translateY(1px);
  }

  .link-item:focus-visible {
    outline: none;
  }

  .link-item:focus-visible .card {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
