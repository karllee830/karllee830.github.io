---
import PixelWordmark from './PixelWordmark.astro';
import Beian from './Beian.astro';
import { site, localize } from '../config/site';
import { localePath, useTranslations, type Lang } from '../i18n/ui';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const siteLinks = [
  { href: localePath(lang, '/'), label: t('nav.home') },
  { href: localePath(lang, '/blog/'), label: t('nav.blog') },
  { href: withBase('/rss.xml'), label: 'RSS' },
];
const elsewhere = site.links
  .filter((link) => !link.internal)
  .map((link) => ({ href: link.href, label: localize(link.label, lang) }));
---

<footer class="site-footer">
  <div class="columns">
    <section>
      <h2>{t('footer.site')}</h2>
      <ul>
        {siteLinks.map((l) => (<li><a class="pill-link cursor sq" href={l.href}>{l.label}</a></li>))}
      </ul>
    </section>
    <section>
      <h2>{t('footer.elsewhere')}</h2>
      <ul>
        {elsewhere.map((l) => (<li><a class="pill-link cursor sq" href={l.href} rel="me noopener">{l.label}</a></li>))}
      </ul>
    </section>
    <div class="copyright">
      <p>© {year} {site.name}</p>
      <Beian class="footer-beian" />
    </div>
  </div>
  <PixelWordmark text={site.wordmark} label={site.name} />
</footer>

<style>
  /* Over half a screen tall: links on top, the wordmark resting at the bottom. */
  .site-footer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-12);
    min-height: max(56svh, 420px);
    margin-top: var(--space-24);
    /* Leave room for the fixed dock on narrow screens. */
    padding: var(--space-12) var(--page-gutter) calc(56px + var(--space-6) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--color-line);
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }

  h2 {
    margin-bottom: var(--space-2);
    font-weight: var(--weight-regular);
    color: var(--color-fg-subtle);
  }

  ul {
    display: grid;
    gap: var(--space-1);
  }

  ul {
    justify-items: start;
  }


  .copyright {
    display: grid;
    gap: var(--space-2);
    grid-column: 1 / -1;
    color: var(--color-fg-subtle);
  }

  /* Filing numbers live in the sidebar on desktop. */
  @media (min-width: 1024px) {
    .copyright :global(.footer-beian) {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .copyright {
      grid-column: 4;
      align-self: end;
      text-align: right;
    }
  }

  /* Desktop: the top rule runs from the sidebar hairline to the frame edge. */
  @media (min-width: 1024px) {
    .site-footer {
      margin-inline: calc(-1 * var(--layout-gap)) calc(-1 * var(--frame-padding));
      padding: var(--space-12) var(--frame-padding) 0 var(--layout-gap);
    }
  }
</style>
