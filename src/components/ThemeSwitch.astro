---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
const options = [
  { value: 'system', icon: 'monitor', label: t('theme.system') },
  { value: 'light', icon: 'sun', label: t('theme.light') },
  { value: 'dark', icon: 'moon', label: t('theme.dark') },
] as const;
---

<div class="segmented sq sq-line" role="group" aria-label={t('theme.label')} data-theme-switch>
  <span class="segment-thumb sq" aria-hidden="true"></span>
  {
    options.map((o) => (
      <button type="button" class="segment sq" data-value={o.value} aria-pressed="false" aria-label={o.label} title={o.label}>
        <Icon name={o.icon} size={14} />
      </button>
    ))
  }
</div>

<script>
  type Pref = 'system' | 'light' | 'dark';
  const KEY = 'theme';
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const read = (): Pref => {
    try {
      const v = localStorage.getItem(KEY);
      return v === 'light' || v === 'dark' ? v : 'system';
    } catch {
      return 'system';
    }
  };

  const resolve = (pref: Pref) => (pref === 'system' ? (media.matches ? 'dark' : 'light') : pref);

  const sync = (pref: Pref) => {
    document.documentElement.dataset.themePref = pref;
    document.querySelectorAll<HTMLElement>('[data-theme-switch] [data-value]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.value === pref));
    });
  };

  const apply = (pref: Pref) => {
    const root = document.documentElement;
    const next = resolve(pref);
    const update = () => {
      root.dataset.theme = next;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#0a0a0a' : '#fafafa');
    };
    const animate =
      root.dataset.theme !== next &&
      'startViewTransition' in document &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (animate) document.startViewTransition(update);
    else update();
    sync(pref);
  };

  document.querySelectorAll<HTMLElement>('[data-theme-switch]').forEach((group) => {
    group.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('[data-value]');
      if (!button) return;
      const pref = button.dataset.value as Pref;
      try {
        if (pref === 'system') localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, pref);
      } catch {
        /* storage unavailable: theme still applies for this page */
      }
      apply(pref);
    });
  });

  media.addEventListener('change', () => {
    if (read() === 'system') apply('system');
  });

  sync(read());
</script>
