---
// Approved comments of a post, fetched at build time from its GitHub issue (see
// src/lib/comments.ts), and a link to write one there. Visitors' comments show up after
// review and the next deploy; the repository owner's right away.
import Icon from './Icon.astro';
import { site } from '../config/site';
import { useTranslations, type Lang } from '../i18n/ui';
import { getThreads } from '../lib/comments';
import { formatDate } from '../lib/posts';

interface Props {
  lang: Lang;
  /** Title of the post's comment issue; independent of domain and base path. */
  term: string;
}

const { lang, term } = Astro.props;
const t = useTranslations(lang);
const thread = (await getThreads()).get(term);
const comments = thread?.comments ?? [];
// Before the deploy workflow has opened the issue, search for it instead.
const writeHref = thread
  ? `${thread.issueUrl}#new_comment_field`
  : `https://github.com/${site.comments.repo}/issues?q=${encodeURIComponent(`is:issue "${term}"`)}`;
---

<section class="comments" aria-labelledby="comments-title">
  <h2 id="comments-title">
    {t('post.comments')}
    {comments.length > 0 && <span class="count mono">{comments.length}</span>}
  </h2>
  <p class="note">{t('post.commentsNote')}</p>

  {
    comments.length > 0 ? (
      <ol class="list">
        {comments.map((c) => (
          <li class="comment sq sq-line" id={`comment-${c.id}`}>
            <header class="head">
              <img class="avatar" src={`${c.avatar}&s=56`} width="28" height="28" alt="" loading="lazy" decoding="async" />
              <a class="author" href={c.authorUrl} rel="nofollow noopener">
                {c.byOwner ? site.author : c.author}
              </a>
              {c.byOwner && <span class="owner-badge sq">{t('post.commentsOwner')}</span>}
              <a class="date mono" href={c.url} rel="nofollow noopener">
                <time datetime={c.createdAt.toISOString()}>{formatDate(c.createdAt)}</time>
              </a>
            </header>
            <div class="body prose" set:html={c.html} />
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">{t('post.commentsEmpty')}</p>
    )
  }

  <a class="write sq sq-line" href={writeHref} target="_blank" rel="noopener">
    <Icon name="github" size={18} />
    {t('post.commentsWrite')}
  </a>
</section>

<style>
  .comments {
    display: grid;
    gap: var(--space-2);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-weight: var(--weight-semibold);
  }

  .count {
    font-size: var(--text-caption);
    font-weight: var(--weight-regular);
    color: var(--color-fg-subtle);
  }

  .note,
  .empty {
    color: var(--color-fg-subtle);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .comment {
    --sq-r: var(--radius-4);
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
  }

  .head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .avatar {
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--color-surface-2);
  }

  .author {
    overflow: hidden;
    font-weight: var(--weight-medium);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Marks the blog author's own comments. */
  .owner-badge {
    --sq-r: 6px;
    flex-shrink: 0;
    padding: 2px 6px;
    font-size: 11px;
    line-height: 1;
    font-weight: var(--weight-medium);
    color: var(--color-accent-ink);
    background-color: var(--color-accent-soft);
  }

  .date {
    margin-left: auto;
    font-size: var(--text-caption);
    color: var(--color-fg-subtle);
  }

  .author:hover,
  .date:hover {
    color: var(--color-fg);
  }

  /* Comment text uses the post's typography, a step smaller. */
  .body {
    font-size: var(--text-body);
  }

  .write {
    --sq-r: var(--radius-3);
    --sq-bg: var(--color-surface);
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-lg);
    margin-top: var(--space-2);
    padding-inline: var(--space-4);
    font-weight: var(--weight-medium);
    transition:
      --sq-bg var(--duration-fast) var(--ease-out),
      --sq-border var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .write:hover {
    --sq-bg: var(--color-hover);
    --sq-border: var(--color-line-strong);
  }

  .write:active {
    transform: scale(0.97);
  }
</style>
