---
// One icon from src/lib/icons, rendered to static SVG at build time. Colours come from
// the CSS `color` of the icon (see base.css); motion is added on first hover.
import { toSvg } from 'kubai-icons';
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const { default: icon } = await ICONS[name]();
const svg = toSvg(icon, { size, className: ['icon', className].filter(Boolean).join(' '), attrs: { 'data-icon': name } });
---

<Fragment set:html={svg} />

<script>
  import { initIconMotion } from '../lib/icons/motion';
  initIconMotion();
</script>
