---

interface Props {
  id: string;
  title: string;
  moreHref?: string;
  moreLabel?: string;
}

const { id, title, moreHref, moreLabel } = Astro.props;
---

<header class="section-header">
  <h2 id={id}>{title}</h2>
  {
    moreHref && (
      <a class="pill-link cursor sq" href={moreHref}>
        {moreLabel}
      </a>
    )
  }
</header>

<style>
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  h2 {
    font-weight: var(--weight-semibold);
  }

</style>
