---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelWordmark from '../components/PixelWordmark.astro';
import Phrases from '../components/Phrases.astro';
import { localePath, useTranslations } from '../i18n/ui';

const zh = useTranslations('zh');
const en = useTranslations('en');
---

<BaseLayout lang="zh" title="404" routes={{ zh: '/', en: '/' }}>
  <section class="not-found">
    <PixelWordmark text="404" crop={1} label="404" />
    <div class="copy">
      <h1><Phrases text={zh('notFound.title')} /></h1>
      <p>{zh('notFound.body')}</p>
      <p lang="en">{en('notFound.title')}. {en('notFound.body')}</p>
    </div>
    <a class="home sq sq-line" href={localePath('zh', '/')}>{zh('notFound.home')}</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-8);
    justify-items: start;
  }

  .not-found :global(.wordmark) {
    max-width: 320px;
  }

  .copy {
    display: grid;
    gap: var(--space-2);
    color: var(--color-fg-muted);
  }

  h1 {
    font-size: var(--text-display);
    line-height: var(--leading-display);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
  }

  .home {
    --sq-r: var(--radius-3);
    --sq-bg: var(--color-fg);
    --sq-border: var(--color-fg);
    display: inline-flex;
    align-items: center;
    height: var(--control-lg);
    padding-inline: var(--space-4);
    font-weight: var(--weight-medium);
    color: var(--color-on-fg);
    white-space: nowrap;
  }

  .home:hover {
    --sq-bg: color-mix(in srgb, var(--color-fg) 85%, var(--color-bg));
  }
</style>
