---
import { Font } from 'astro:assets';
import SiteNav, { type Section } from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import { htmlLang, langs, localeRoute, ogLocale, useTranslations, type Lang } from '../i18n/ui';
import { withBase } from '../lib/url';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/controls.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  section?: Section;
  /** Locale-free route of this page in each language, e.g. { zh: '/blog/', en: '/blog/' }. */
  routes?: Partial<Record<Lang, string>>;
  /** Where the language switch points when this page has no translation. */
  fallbackRoute?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const { lang, title, description, section = 'none', routes = {}, fallbackRoute = '/', type = 'website', publishedTime } = Astro.props;
const t = useTranslations(lang);
const meta = site.meta[lang];
const pageTitle = title ? `${title} · ${meta.title}` : meta.title;
const pageDescription = description ?? meta.description;

const canonical = new URL(Astro.url.pathname, Astro.site);
const langHrefs = Object.fromEntries(
  langs.map((l) => [l, withBase(localeRoute(l, routes[l] ?? fallbackRoute))]),
) as Record<Lang, string>;
const alternates = langs.filter((l) => routes[l]).map((l) => ({ lang: htmlLang[l], href: new URL(langHrefs[l], Astro.site).href }));
const avatarUrl = withBase('/avatar.png');
const ogImage = new URL(avatarUrl, Astro.site);
---

<!doctype html>
<html lang={htmlLang[lang]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" type="application/rss+xml" title={meta.title} href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="apple-touch-icon" href={avatarUrl} />
    <meta name="theme-color" content="#fafafa" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />

    <script is:inline>
      // Resolve the theme before first paint to avoid a flash.
      (function () {
        var pref = null;
        try {
          pref = localStorage.getItem('theme');
        } catch (e) {}
        var dark = pref === 'dark' || (pref !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.dataset.themePref = pref === 'light' || pref === 'dark' ? pref : 'system';
        if (dark) document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0a0a0a');
      })();
    </script>

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-code" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <div class="shell">
      <div class="layout">
        <SiteNav lang={lang} section={section} langHrefs={langHrefs} />
        <main id="main" class="main">
          <slot />
        </main>
      </div>
      <SiteFooter lang={lang} />
    </div>

    <script>
      import { initSquircles } from '../lib/squircle';
      initSquircles();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-3);
    background: var(--color-fg);
    color: var(--color-on-fg);
    border-radius: var(--radius-2);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .shell {
    min-height: 100dvh;
    overflow-x: clip;
    background-color: var(--color-bg);
  }

  .main {
    width: 100%;
    max-width: calc(var(--content-width) + 2 * var(--page-gutter));
    margin-inline: auto;
    padding: var(--space-10) var(--page-gutter) 0;
  }

  /* Desktop: hatched gutters, hairline frame, sticky sidebar. */
  @media (min-width: 1024px) {
    html {
      background-image: repeating-linear-gradient(
        -45deg,
        var(--color-hatch) 0 1px,
        transparent 1px 8px
      );
      background-attachment: fixed;
    }

    body {
      background: none;
    }

    .shell {
      max-width: calc(var(--sidebar-width) + var(--layout-gap) + var(--content-width) + 2 * var(--frame-padding) + 2px);
      margin-inline: auto;
      border-inline: 1px solid var(--color-line);
    }

    .layout {
      display: grid;
      grid-template-columns: var(--sidebar-width) minmax(0, var(--content-width));
      gap: var(--layout-gap);
      padding-inline: var(--frame-padding);
    }

    .main {
      max-width: none;
      margin: 0;
      padding: var(--space-12) 0 0;
    }
  }
</style>
